{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Homework capture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "subject", "dueDate", "dueTime", "estimateMinutes", "priority", "notes", "subtasks", "afterCompletion"],
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "subject": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 },
    "dueDate": { "type": ["string", "null"], "format": "date", "description": "Local calendar date, YYYY-MM-DD." },
    "dueTime": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "description": "Local 24-hour HH:mm, only for a stated clock time with a due date." },
    "estimateMinutes": { "type": ["integer", "null"], "minimum": 5, "maximum": 240 },
    "priority": { "type": "string", "enum": ["normal", "high"] },
    "notes": { "type": "string", "maxLength": 1600 },
    "subtasks": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
    "afterCompletion": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 160 }, "description": "Follow-up reminders triggered when the student marks this task done." }
  }
}
